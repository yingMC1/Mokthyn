{
    "version": 4,
    "env": {
        "systemIncludePath": [
            "${workspaceFolder}/ege",
            "${workspaceFolder}/ege/include"
        ]
    },
    "configurations": [
        {
            "name": "Mac",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "defines": [
                "SHOW_CONSOLE=1"
            ],
            "compilerArgs": [
                "-mwindows",
                "-static",
                "-static-libgcc",
                "-static-libstdc++"
            ],
            "includePath": [
                "${myDefaultIncludePath}"
            ],
            "configurationProvider": "ms-vscode.cmake-tools"
        },
        {
            "name": "Linux",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "compilerPath": "x86_64-w64-mingw32-g++",
            "defines": [
                "SHOW_CONSOLE=1"
            ],
            "compilerArgs": [
                "-mwindows",
                "-static",
                "-static-libgcc",
                "-static-libstdc++"
            ],
            "includePath": [
                "${myDefaultIncludePath}"
            ],
            "configurationProvider": "ms-vscode.cmake-tools"
        },
        {
            "name": "Win32",
            "cStandard": "c23",
            "cppStandard": "c++26",
            "compilerPath": "D:/mingw64/bin/g++.exe",
            "defines": [
                "SHOW_CONSOLE=1",
                "_CRT_SECURE_NO_WARNINGS=1",
                "NOMINMAX=1"
            ],
            "compilerArgs": [
                "/Zc:__cplusplus"
            ],
            "includePath": [
                "${myDefaultIncludePath}"
            ],
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "enableConfigurationSquiggles": false
}