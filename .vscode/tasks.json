{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Load Project",
      "type": "shell",
      "command": "bash",
      "args": ["-l", "-c", "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$gcc",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-Command",
          "& \"$env:ProgramFiles\\CMake\\bin\\cmake.exe\" -S . -B build -DCMAKE_BUILD_TYPE=Debug"
        ],
        "options": { "cwd": "${workspaceFolder}" }
      }
    },
    {
      "label": "Build Project (Debug)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-l",
        "-c",
        "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build --config Debug --parallel"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$gcc",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-Command",
          "& \"$env:ProgramFiles\\CMake\\bin\\cmake.exe\" -S . -B build -DCMAKE_BUILD_TYPE=Debug; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & \"$env:ProgramFiles\\CMake\\bin\\cmake.exe\" --build build --config Debug --parallel; exit $LASTEXITCODE"
        ],
        "options": { "cwd": "${workspaceFolder}" }
      }
    },
    {
      "label": "Build Project (Release)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-l",
        "-c",
        "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --config Release --parallel"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$gcc",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-Command",
          "& \"$env:ProgramFiles\\CMake\\bin\\cmake.exe\" -S . -B build -DCMAKE_BUILD_TYPE=Release; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & \"$env:ProgramFiles\\CMake\\bin\\cmake.exe\" --build build --config Release --parallel; exit $LASTEXITCODE"
        ],
        "options": { "cwd": "${workspaceFolder}" }
      }
    },
    {
      "label": "Load And Build Project (Debug)",
      "dependsOn": ["Load Project", "Build Project (Debug)"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Load And Build Project (Release)",
      "dependsOn": ["Load Project", "Build Project (Release)"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Run Project (Debug)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-l",
        "-c",
        "if command -v wine64 >/dev/null 2>&1; then wine64 ./ege-demo.exe; else wine ./ege-demo.exe; fi"
      ],
      "options": { "cwd": "${workspaceFolder}/build/Debug" },
      "dependsOn": ["Build Project (Debug)"],
      "problemMatcher": "$gcc",
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-Command", ".\\ege-demo.exe"],
        "options": { "cwd": "${workspaceFolder}/build/Debug" }
      }
    },
    {
      "label": "Run Project (Release)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-l",
        "-c",
        "if command -v wine64 >/dev/null 2>&1; then wine64 ./ege-demo.exe; else wine ./ege-demo.exe; fi"
      ],
      "options": { "cwd": "${workspaceFolder}/build/Release" },
      "dependsOn": ["Build Project (Release)"],
      "problemMatcher": "$gcc",
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-Command", ".\\ege-demo.exe"],
        "options": { "cwd": "${workspaceFolder}/build/Release" }
      }
    },
    {
      "label": "Clean Project",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--target", "clean"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$gcc",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-Command",
          "& \"$env:ProgramFiles\\CMake\\bin\\cmake.exe\" --build build --target clean"
        ],
        "options": { "cwd": "${workspaceFolder}" }
      }
    }
  ]
}
