{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Load Project (Debug)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-l",
        "-c",
        "cmake -S . -B build/cmake-debug -DCMAKE_BUILD_TYPE=Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "CMAKE_GENERATOR": "Unix Makefiles" }
      },
      "problemMatcher": "$gcc",
      "windows": {
        "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
        "args": ["--preset", "debug"],
        "options": { "cwd": "${workspaceFolder}" }
      }
    },
    {
      "label": "Build Project (Debug)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-l",
        "-c",
        "cmake -S . -B build/cmake-debug -DCMAKE_BUILD_TYPE=Debug && cmake --build build/cmake-debug --config Debug --parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "CMAKE_GENERATOR": "Unix Makefiles" }
      },
      "group": "build",
      "problemMatcher": "$gcc",
      "windows": {
        "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
        "args": ["--build", "--preset", "debug"],
        "options": { "cwd": "${workspaceFolder}" }
      }
    },
    {
      "label": "Build Project (Release)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-l",
        "-c",
        "cmake -S . -B build/cmake-release -DCMAKE_BUILD_TYPE=Release && cmake --build build/cmake-release --config Release --parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "CMAKE_GENERATOR": "Unix Makefiles" }
      },
      "group": "build",
      "problemMatcher": "$gcc",
      "windows": {
        "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
        "args": ["--build", "--preset", "release"],
        "options": { "cwd": "${workspaceFolder}" }
      }
    },
    {
      "label": "Load And Build Project (Debug)",
      "dependsOn": ["Load Project (Debug)", "Build Project (Debug)"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Load And Build Project (Release)",
      "dependsOn": ["Load Project (Debug)", "Build Project (Release)"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Run Project (Debug)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-l",
        "-c",
        "if command -v wine64 >/dev/null 2>&1; then wine64 ./Mokthyn.exe; else wine ./Mokthyn.exe; fi"
      ],
      "options": { "cwd": "${workspaceFolder}/build/Debug" },
      "dependsOn": ["Build Project (Debug)"],
      "problemMatcher": "$gcc",
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-Command", ".\\Mokthyn.exe"],
        "options": { "cwd": "${workspaceFolder}/build/Debug" }
      }
    },
    {
      "label": "Run Project (Release)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-l",
        "-c",
        "if command -v wine64 >/dev/null 2>&1; then wine64 ./Mokthyn.exe; else wine ./Mokthyn.exe; fi"
      ],
      "options": { "cwd": "${workspaceFolder}/build/Release" },
      "dependsOn": ["Build Project (Release)"],
      "problemMatcher": "$gcc",
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-Command", ".\\Mokthyn.exe"],
        "options": { "cwd": "${workspaceFolder}/build/Release" }
      }
    },
    {
      "label": "Clean Project (Debug)",
      "type": "shell",
      "command": "bash",
      "args": ["-l", "-c", "cmake --build build/cmake-debug --target clean"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$gcc",
      "windows": {
        "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
        "args": ["--build", "--preset", "debug", "--target", "clean"],
        "options": { "cwd": "${workspaceFolder}" }
      }
    },
    {
      "label": "Clean Project (Release)",
      "type": "shell",
      "command": "bash",
      "args": ["-l", "-c", "cmake --build build/cmake-release --target clean"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$gcc",
      "windows": {
        "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
        "args": ["--build", "--preset", "release", "--target", "clean"],
        "options": { "cwd": "${workspaceFolder}" }
      }
    }
  ]
}
