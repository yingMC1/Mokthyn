{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Load Project",
      "type": "shell",
      "command": "bash",
      "args": [
        "-l",
        "-c",
        "cmake -S . -B build/cmake-debug -DCMAKE_BUILD_TYPE=Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "CMAKE_GENERATOR": "Unix Makefiles" }
      },
      "problemMatcher": "$gcc",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-Command",
          "& \"$env:ProgramFiles\\CMake\\bin\\cmake.exe\" -S . -B build/cmake-debug -DCMAKE_BUILD_TYPE=Debug -DCMAKE_SYSTEM_NAME=Windows -DCMAKE_CXX_COMPILER=D:/mingw64/bin/x86_64-w64-mingw32-g++.exe -DCMAKE_RC_COMPILER=D:/mingw64/bin/windres.exe"
        ],
        "options": {
          "cwd": "${workspaceFolder}",
          "env": { "CMAKE_GENERATOR": "MinGW Makefiles" }
        }
      }
    },
    {
      "label": "Build Project (Debug)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-l",
        "-c",
        "cmake -S . -B build/cmake-debug -DCMAKE_BUILD_TYPE=Debug && cmake --build build/cmake-debug --config Debug --parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "CMAKE_GENERATOR": "Unix Makefiles" }
      },
      "group": "build",
      "problemMatcher": "$gcc",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-Command",
          "& \"$env:ProgramFiles\\CMake\\bin\\cmake.exe\" -S . -B build/cmake-debug -DCMAKE_BUILD_TYPE=Debug -DCMAKE_SYSTEM_NAME=Windows -DCMAKE_CXX_COMPILER=D:/mingw64/bin/x86_64-w64-mingw32-g++.exe -DCMAKE_RC_COMPILER=D:/mingw64/bin/windres.exe; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & \"$env:ProgramFiles\\CMake\\bin\\cmake.exe\" --build build/cmake-debug --config Debug --parallel; exit $LASTEXITCODE"
        ],
        "options": {
          "cwd": "${workspaceFolder}",
          "env": { "CMAKE_GENERATOR": "MinGW Makefiles" }
        }
      }
    },
    {
      "label": "Build Project (Release)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-l",
        "-c",
        "cmake -S . -B build/cmake-release -DCMAKE_BUILD_TYPE=Release && cmake --build build/cmake-release --config Release --parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "CMAKE_GENERATOR": "Unix Makefiles" }
      },
      "group": "build",
      "problemMatcher": "$gcc",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-Command",
          "& \"$env:ProgramFiles\\CMake\\bin\\cmake.exe\" -S . -B build/cmake-release -DCMAKE_BUILD_TYPE=Release -DCMAKE_SYSTEM_NAME=Windows -DCMAKE_CXX_COMPILER=D:/mingw64/bin/x86_64-w64-mingw32-g++.exe -DCMAKE_RC_COMPILER=D:/mingw64/bin/windres.exe; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & \"$env:ProgramFiles\\CMake\\bin\\cmake.exe\" --build build/cmake-release --config Release --parallel; exit $LASTEXITCODE"
        ],
        "options": {
          "cwd": "${workspaceFolder}",
          "env": { "CMAKE_GENERATOR": "MinGW Makefiles" }
        }
      }
    },
    {
      "label": "Load And Build Project (Debug)",
      "dependsOn": ["Load Project", "Build Project (Debug)"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Load And Build Project (Release)",
      "dependsOn": ["Load Project", "Build Project (Release)"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Run Project (Debug)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-l",
        "-c",
        "if command -v wine64 >/dev/null 2>&1; then wine64 ./ege-demo.exe; else wine ./ege-demo.exe; fi"
      ],
      "options": { "cwd": "${workspaceFolder}/build/Debug" },
      "dependsOn": ["Build Project (Debug)"],
      "problemMatcher": "$gcc",
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-Command", ".\\ege-demo.exe"],
        "options": { "cwd": "${workspaceFolder}/build/Debug" }
      }
    },
    {
      "label": "Run Project (Release)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-l",
        "-c",
        "if command -v wine64 >/dev/null 2>&1; then wine64 ./ege-demo.exe; else wine ./ege-demo.exe; fi"
      ],
      "options": { "cwd": "${workspaceFolder}/build/Release" },
      "dependsOn": ["Build Project (Release)"],
      "problemMatcher": "$gcc",
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-Command", ".\\ege-demo.exe"],
        "options": { "cwd": "${workspaceFolder}/build/Release" }
      }
    },
    {
      "label": "Clean Project",
      "type": "shell",
      "args": [
        "-l",
        "-c",
        "cmake --build build/cmake-debug --target clean && cmake --build build/cmake-release --target clean"
      ],
      "command": "bash",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$gcc",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-Command",
          "& \"$env:ProgramFiles\\CMake\\bin\\cmake.exe\" --build build/cmake-debug --target clean; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & \"$env:ProgramFiles\\CMake\\bin\\cmake.exe\" --build build/cmake-release --target clean; exit $LASTEXITCODE"
        ],
        "options": { "cwd": "${workspaceFolder}" }
      }
    }
  ]
}
